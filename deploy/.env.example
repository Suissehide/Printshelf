# Docker compose stack settings
COMPOSE_PROJECT_NAME='printshelf'
CONTAINER_REGISTRY_PREFIX=''
VERSION=0.1.0
APP_IMAGE_NAME=printshelf
NODE_VERSION=24.11.0

# Domaine servi par Traefik (HTTPS obligatoire : l'authentification est en HTTP Basic).
TRAEFIK_HOST=printshelf.example.com
TRAEFIK_CERT_RESOLVER=letsencrypt

# Dossier des modèles sur l'hôte, monté en lecture seule sur /models dans le conteneur.
# Dans l'app, ajoutez ensuite /models (ou un de ses sous-dossiers) comme source.
MODELS_DIR=/srv/modeles-3d

# Identifiants de connexion. Mot de passe : 12 caractères minimum, sinon le back refuse de
# démarrer. Générer par exemple avec `openssl rand -base64 24`.
AUTH_USER=printshelf
AUTH_PASSWORD="CHANGE_ME"
